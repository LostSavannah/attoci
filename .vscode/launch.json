{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "ATTOCI_DB_MIGRATIONS_PATH": "${workspaceFolder}/src/manager/data/migrations",
                "ATTOCI_DB_DATABASES_PATH": "${workspaceFolder}/src/manager/data/databases",
                "ATTOCI_DB_JSON_PATH": "${workspaceFolder}/src/manager/data/json",
            }
        },
        {
            "name": "Launch file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "env": {
                "ATTOCI_URL": "http://localhost:8089",
                "ATTOCI_API_KEY": "12345678",
                "ATTOCI_AGENT_ID": "atc_2049812650912364613541234",
            }
        },
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "env": {
                "ATTOCI_URL": "http://localhost:8089",
                "ATTOCI_API_KEY": "12345678",
                "ATTOCI_AGENT_ID": "atc_2049812650912364613541234",
            }
        }
    ]
}